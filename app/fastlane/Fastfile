default_platform(:ios)

BUNDLE_ID = "com.agendalogo.app"

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV["APPSTORE_KEY_ID"],
    issuer_id: ENV["APPSTORE_ISSUER_ID"],
    key_content: ENV["APPSTORE_P8"],
    is_key_content_base64: false,
    duration: 1200
  )
end

platform :ios do
  desc "Compila o app e envia para o TestFlight"
  lane :release do
    api_key = connect_api_key

    # Cria o app na App Store Connect (se ja existir, apenas avisa e continua)
    begin
      produce(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        app_name: "Agenda Logo",
        app_primary_language: "Portuguese (Brazil)",
        team_id: ENV["APPLE_TEAM_ID"],
        skip_itc: false
      )
    rescue => e
      UI.warning("produce: #{e.message}")
      UI.warning("Se o app ja foi criado manualmente na App Store Connect, pode ignorar este aviso.")
    end

    # Gera o projeto Xcode a partir do project.yml
    sh("xcodegen", "generate")

    # Certificado + perfil de provisionamento (guardados criptografados no branch 'signing' deste repositorio)
    match(
      type: "appstore",
      readonly: false,
      app_identifier: BUNDLE_ID,
      team_id: ENV["APPLE_TEAM_ID"],
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "signing",
      shallow_clone: false
    )

    build_app(
      project: "AgendaLogo.xcodeproj",
      scheme: "AgendaLogo",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Manual",
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: lane_context[SharedValues::XCODEBUILD_IPA_PATH],
      skip_waiting_for_build_processing: true
    )

    UI.success("Build enviado para o TestFlight com sucesso!")
  end
end
